{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VidFetch",
  "version": "0.7.0-alpha",
  "identifier": "be.mystic.vidfetch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VidFetch",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "category": "Utility",
    "shortDescription": "A sleek yt-dlp GUI wrapper",
    "longDescription": "VidFetch is a modern, cross-platform GUI for yt-dlp. Download videos, audio, playlists and subtitles from hundreds of sites — no terminal required."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/YliasR/VidFetch/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3QzA4MzA0RDg5MzQwQ0UKUldUT1FKUFlCSVBBaDE5dTUyc0FLRHlUWm1DZnE0TXRFMG1id2tNZE5PaFpQNFduajI3em5tV2oK"
    }
  }
}
