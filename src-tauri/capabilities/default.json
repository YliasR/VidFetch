{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for VidFetch main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:path:default",
    "core:event:default",
    "core:app:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "shell:default",
    "shell:allow-open",
    "opener:default",
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }, { "path": "$HOME/**" }]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "**" }, { "path": "$HOME/**" }]
    },
    "store:default",
    "notification:default",
    "updater:default",
    "process:default",
    "process:allow-restart",
    "clipboard-manager:allow-read-text"
  ]
}
